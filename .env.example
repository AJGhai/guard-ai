# Server-side only. Next.js and the setup commands read this file; the browser
# never sees it. Copy to .env and fill in. .env is ignored by Git.

# A Platform Project key from https://platform.zoowork.ai → your Project → API Keys.
# It starts with zwp_live_. Do not paste it into chat, browser code, logs or Git.
ZOOWORK_API_KEY=zwp_live_replace_with_your_project_key

# Optional. ZooData key for live Amazon comparables (tools/comparables.py), from
# https://zoodata.ai/en/api-keys. It starts with hms_live_. Without it, comparables
# use market/fallback_prices.json. Live results are cached in market/cache/.
ZOODATA_API_KEY=hms_live_replace_with_your_key
